# PostgreSQL & Redis
DATABASE_URL="postgresql://amplyra:amplyra_dev_password@localhost:5432/amplyra?schema=public"
REDIS_URL="redis://localhost:6379"

# API Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN="http://localhost:3000"

# Auth Secrets (replace with strong random secrets in production)
JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Frontend
NEXT_PUBLIC_API_URL="/api/v1"
API_INTERNAL_URL="http://127.0.0.1:4000"

# Social OAuth & Token Encryption (AES-256-GCM)
# When platform keys are omitted, OAuth adapters run in labeled local sandbox mode
SOCIAL_TOKEN_SECRET="change-me-32-char-social-encryption-secret"
META_APP_ID=""
META_APP_SECRET=""
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""

# Payment Partner Integration (Paystack; runs in labeled local sandbox ledger when omitted)
PAYSTACK_SECRET_KEY=""

# Optional AI Providers (uses deterministic brand-aware fallback when omitted)
GEMINI_API_KEY=""
OPENAI_API_KEY=""
